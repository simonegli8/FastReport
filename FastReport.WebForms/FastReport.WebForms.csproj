<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FastReport.WebForms</RootNamespace>
    <AssemblyName>FastReport.WebForms</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FastReport.OpenSource.snk</AssemblyOriginatorKeyFile>

    <PackageId>FastReport.OpenSource.WebForms</PackageId>
    <Authors>Fast Reports Inc.</Authors>
    <Company>Fast Reports Inc.</Company>
    <Product>FastReport</Product>
    <PackageTags>reporting, reports, pdf, svg, webforms, asp.net</PackageTags>
    <Description>
      ASP.NET Web Forms control for FastReport Open Source: renders prepared reports as inline SVG and
      offers them as vector PDF downloads. Rendering uses SkiaSharp (FastReport.Drawing.Skia), not GDI+.
    </Description>
  </PropertyGroup>

  <!-- Package metadata, as in FastReport.OpenSource.Web -->
  <PropertyGroup>
    <Copyright>Fast Reports Inc.</Copyright>
    <Version>1.0.0</Version>
    <PackageLicenseFile>FastReport MIT license.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://www.fast-report.com/products/fast-report-net</PackageProjectUrl>
    <PackageIcon>frlogo192.png</PackageIcon>
    <RepositoryUrl>https://github.com/FastReports/FastReport</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--See https://devblogs.microsoft.com/dotnet/producing-packages-with-source-link/#deterministic-builds -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Pack\FastReport MIT license.md">
      <Pack>True</Pack>
      <Visible>false</Visible>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\Pack\frlogo192.png">
      <Pack>True</Pack>
      <Visible>false</Visible>
      <PackagePath></PackagePath>
    </None>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net48'">
    <Reference Include="System.Web" />
  </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="WebFormsForCore.Web" Version="1.6.4" />
    </ItemGroup>
    
    <ItemGroup>
    <ProjectReference Include="..\FastReport.OpenSource\FastReport.OpenSource.csproj" />
  </ItemGroup>

</Project>
