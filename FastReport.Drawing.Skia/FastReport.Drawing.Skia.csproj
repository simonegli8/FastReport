<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>System.Drawing</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Strong-named like FastReport.Compat and FastReport, which reference it. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\FastReport.OpenSource.snk</AssemblyOriginatorKeyFile>
    <Description>Skia-based replacement for the System.Drawing.Common API surface used by FastReport, including a SkiaSharp implementation of FastReport.IGraphics.</Description>
    <!-- GDI+-compatible API: many members are intentionally undocumented mirrors of System.Drawing.Common. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Package metadata, as in FastReport.Compat -->
  <PropertyGroup>
    <PackageId>FastReport.Drawing.Skia</PackageId>
    <Authors>Fast Reports Inc.</Authors>
    <Company>Fast Reports Inc.</Company>
    <Product>FastReport</Product>
    <Copyright>Copyright © Fast Reports Inc. 2007-2026</Copyright>
    <Version>1.0.0</Version>
    <PackageTags>reporting, reports, skia, skiasharp, drawing, system.drawing</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://www.fast-report.com/products/fast-report-net</PackageProjectUrl>
    <PackageIcon>frlogo192.png</PackageIcon>
    <RepositoryUrl>https://github.com/FastReports/FastReport</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\FastReport.Compat\LICENSE.md">
      <Pack>True</Pack>
      <Visible>false</Visible>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\Pack\frlogo192.png">
      <Pack>True</Pack>
      <Visible>false</Visible>
      <PackagePath></PackagePath>
    </None>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
  </ItemGroup>

  <!--
    .NET Framework: System.Drawing.dll holds both the primitives (Point, Color, ...) and GDI+, so this assembly
    must not reference it and provides its own primitives instead (on .NET 10 they come from System.Drawing.Primitives).
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)'!='.NETFramework'">
    <Compile Remove="Primitives\**;Polyfills\**" />
  </ItemGroup>

  <!--
    IGraphics is shared with FastReport.Compat as source, so that in this assembly it is compiled
    against the Skia-backed System.Drawing types defined here instead of System.Drawing.Common.
  -->
  <ItemGroup>
    <Compile Include="..\FastReport.Compat\shared\DotNetClasses\IGraphics.cs" Link="Compat\IGraphics.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--<ProjectReference Include="..\FastReport.Compat\FastReport.Compat\FastReport.Compat.csproj" />-->
  </ItemGroup>

</Project>
