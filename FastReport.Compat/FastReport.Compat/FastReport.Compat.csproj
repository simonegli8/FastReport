<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    All targets draw with SkiaSharp through FastReport.Drawing.Skia instead of GDI+ (System.Drawing.Common
    or, on .NET Framework, System.Drawing.dll). Windows Forms types are replaced too, because the real
    Windows Forms API is built on the GDI+ System.Drawing types.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SKIA</DefineConstants>
    <WindowsFormsReplacement>true</WindowsFormsReplacement>
    <!--
      Directory.Build.props disables BuildProjectReferences (its Configuration check runs before the SDK
      defaults Configuration, so it always applies). The Skia project reference must be built.
    -->
    <BuildProjectReferences>true</BuildProjectReferences>
  </PropertyGroup>

  <!--Explicit import Directory.Build.props (for old-style csproj)-->
  <Import Project="..\Directory.Build.props" Condition="'$(UsingMicrosoftNETSdk)' != 'true'"/>

  <Import Project="$(SlnDir)\UsedPackages.version" />
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisCSharpVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="$(CodeAnalysisVisualBasicVersion)" />
  </ItemGroup>

  <!-- IGraphics is compiled into FastReport.Drawing.Skia (against its types), and GdiGraphics is replaced by SkiaGraphics. -->
  <ItemGroup>
    <ProjectReference Include="..\..\FastReport.Drawing.Skia\FastReport.Drawing.Skia.csproj" />
    <Compile Remove="$(SourceCode)\DotNetClasses\IGraphics.cs" />
    <Compile Remove="$(SourceCode)\DotNetClasses\GdiGraphics.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md">
      <Pack>True</Pack>
      <Visible>false</Visible>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
